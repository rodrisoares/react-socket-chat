# Ambiente de teste — banco proprio, nunca o dev.db
PORT=8081
DATABASE_URL="file:./test.db"
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=segredo-de-teste-nao-usar-em-producao
JWT_EXPIRES_IN=1h

# A suite faz dezenas de logins; o limite de producao a quebraria.
LOGIN_RATE_LIMIT=10000
# Custo minimo do bcrypt: os testes checam o formato do hash, nao a dureza.
BCRYPT_ROUNDS=4

# A suite envia centenas de mensagens; os limites de producao a quebrariam.
MESSAGE_RATE_LIMIT=100000
CREATE_CHAT_RATE_LIMIT=100000

# A suite busca e envia anexos em rajada; os limites de producao a quebrariam.
SEARCH_RATE_LIMIT=100000
UPLOAD_RATE_LIMIT=100000
REFRESH_EXPIRES_DAYS=30
# A suite exporta varias vezes; o limite de producao a quebraria.
EXPORT_RATE_LIMIT=10000

# Cadastro e renovacao: altos aqui, a suite cria dezenas de contas do mesmo IP
REGISTER_RATE_LIMIT=1000
REFRESH_RATE_LIMIT=1000
