# Porta em que o servidor escuta
PORT=8080

# Origens permitidas no CORS, separadas por virgula
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Banco SQLite (Prisma)
DATABASE_URL="file:./dev.db"

# Autenticacao — gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-aleatorio
# Validade do access token. Curta: encerrar uma sessao so o alcanca quando ele
# vence. Quem mantem o usuario logado e o refresh (REFRESH_EXPIRES_DAYS).
JWT_EXPIRES_IN=15m

# Chave das URLs assinadas dos anexos. Separada do JWT: a assinatura do anexo
# circula em cada <img> e em todo link repassado, exposicao que o segredo das
# sessoes nunca tem. Sem esta variavel, uma chave e derivada do JWT_SECRET.
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ATTACHMENT_SECRET=

# Tentativas de login por janela de 15 min
LOGIN_RATE_LIMIT=10
# Cadastros e renovacoes de sessao por janela de 15 min, por IP
REGISTER_RATE_LIMIT=20
REFRESH_RATE_LIMIT=120
# Custo do bcrypt (10 e o padrao; use 4 apenas em teste)
BCRYPT_ROUNDS=10

# Mensagens por minuto e conversas criadas por 15 min, por usuario
MESSAGE_RATE_LIMIT=60
CREATE_CHAT_RATE_LIMIT=30

# Buscas por minuto e anexos por 15 min, por usuario
SEARCH_RATE_LIMIT=90
UPLOAD_RATE_LIMIT=40
# Exportacoes de dados por hora, por usuario. Cada uma le o historico inteiro.
EXPORT_RATE_LIMIT=5

# Validade do refresh token, em dias
REFRESH_EXPIRES_DAYS=30

# O refresh token viaja num cookie httpOnly. "lax" serve quando a API e a tela
# dividem o mesmo site (no dev muda so a porta do localhost); em dominios
# diferentes use "none" — e ai o navegador exige HTTPS, entao COOKIE_SECURE=true.
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false
